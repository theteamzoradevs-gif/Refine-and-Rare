# Database — Supabase Postgres
# Dashboard → Connect → Session pooler (NOT "Direct"). Direct db.*.supabase.co is
# IPv6-only and often fails with P1001 on home/Windows networks.
# Username must be postgres.<PROJECT_REF> (with a dot). Encode @ in password as %40.
#
# Session pooler (use this for local db:setup + app):
# DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
#
# Transaction pooler (optional for Vercel serverless later):
# DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Leave unset to run on static content. DATABASE_ENABLED="false" forces off.

